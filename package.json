{
  "name": "testguard-cli",
  "version": "0.14.0",
  "description": "Breaks your code on purpose and reports every promise your tests did not notice breaking. Mutation testing bound to the claims a project makes — vitest, jest, Playwright, pytest and unittest.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "cli",
    "src",
    "spec/schemas",
    "spec/lib",
    "spec/GATE-SEMANTICS.md",
    "spec/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "testguard": "node cli/testguard.mjs",
    "claims": "node cli/testguard.mjs claims",
    "probe": "node cli/testguard.mjs probe",
    "baseline": "node cli/testguard.mjs baseline",
    "brief": "node cli/testguard.mjs brief",
    "test": "vitest run",
    "test:spec": "vitest run spec/conformance",
    "self:probe": "node cli/testguard.mjs probe . --budget 180000",
    "release:sync": "node .github/scripts/sync-release-version.mjs",
    "prepublishOnly": "node cli/testguard.mjs --version && node .github/scripts/sync-release-version.mjs --check",
    "test:install": "node .github/scripts/install-smoke.mjs"
  },
  "keywords": [
    "testing",
    "fault-injection",
    "mutation-testing",
    "test-quality",
    "claims",
    "verification",
    "vitest",
    "ai-agents",
    "test-generation",
    "claim-verification",
    "github-actions",
    "quality-gate"
  ],
  "devDependencies": {
    "jest": "^30.5.2",
    "vitest": "^5.0.1"
  },
  "bin": {
    "testguard": "cli/testguard.mjs"
  },
  "author": "Ricardo Accioly <raccioly@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raccioly/testguard.git"
  },
  "homepage": "https://github.com/raccioly/testguard#readme",
  "bugs": {
    "url": "https://github.com/raccioly/testguard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
