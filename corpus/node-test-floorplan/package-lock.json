{
  "name": "floorplan-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "floorplan-workspace",
      "workspaces": [
        "packages/geometry",
        "packages/planner"
      ]
    },
    "node_modules/@floorplan/geometry": {
      "resolved": "packages/geometry",
      "link": true
    },
    "node_modules/@floorplan/planner": {
      "resolved": "packages/planner",
      "link": true
    },
    "packages/geometry": {
      "name": "@floorplan/geometry",
      "version": "1.0.0"
    },
    "packages/planner": {
      "name": "@floorplan/planner",
      "version": "1.0.0",
      "dependencies": {
        "@floorplan/geometry": "1.0.0"
      }
    }
  }
}
