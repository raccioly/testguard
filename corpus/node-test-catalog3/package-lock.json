{
  "name": "shelfmark-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "shelfmark-workspace",
      "workspaces": [
        "packages/core",
        "packages/search",
        "packages/report"
      ]
    },
    "node_modules/@shelf/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@shelf/report": {
      "resolved": "packages/report",
      "link": true
    },
    "node_modules/@shelf/search": {
      "resolved": "packages/search",
      "link": true
    },
    "packages/core": {
      "name": "@shelf/core",
      "version": "1.0.0"
    },
    "packages/report": {
      "name": "@shelf/report",
      "version": "1.0.0",
      "dependencies": {
        "@shelf/core": "1.0.0",
        "@shelf/search": "1.0.0"
      }
    },
    "packages/search": {
      "name": "@shelf/search",
      "version": "1.0.0",
      "dependencies": {
        "@shelf/core": "1.0.0"
      }
    }
  }
}
