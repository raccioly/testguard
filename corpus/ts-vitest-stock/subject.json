{
  "runner": "vitest",
  "install": "npm",
  "testFiles": "^test/.*\\.test\\.ts$",
  "budgetMs": 15000,
  "typecheck": true,
  "probeArgs": [
    "--runner",
    "vitest"
  ],
  "noise": [
    {
      "add": "src/unused-banner.ts",
      "content": "// corpus metamorphic noise: an unrelated module nothing imports\nexport const BANNER = 'corpus';\n"
    },
    {
      "rename": [
        "SPEC.md",
        "docs/SPEC.md"
      ]
    }
  ]
}
