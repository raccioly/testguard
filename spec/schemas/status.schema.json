{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:claimspec:v1:status",
  "title": "claimspec v1 \u2014 status",
  "description": "The single machine-readable answer to 'where is this project and what should happen next'. Every human rendering (CLI text, agent brief, skill instructions) derives from this document so they cannot disagree. Computed from the claims file, the evidence, the baseline and the current working tree; never from a cached verdict alone.",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "generatedAt",
    "state",
    "next",
    "counts"
  ],
  "properties": {
    "originPolicy": { "$ref": "urn:claimspec:v1:common#/$defs/originPolicy" },
    "origins": { "$ref": "urn:claimspec:v1:common#/$defs/originSummary" },
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "$ref": "urn:claimspec:v1:common#/$defs/tool"
    },
    "generatedAt": {
      "$ref": "urn:claimspec:v1:common#/$defs/isoDateTime"
    },
    "state": {
      "description": "no-claims: no claims file or a valid empty claims file. unclaimed-changes: the change measured against a reference touches source files that carry no claim and no excusing ignore entry (only computed when a reference is known; it precedes every evidence state because the claim is written before more code). invalid-anchors: one or more exact fault anchors are missing or ambiguous, so probing would be unable to apply them. unprobed: claims but no confirmed evidence. evidence-stale: evidence exists but a claim, fault, target or defender changed since. provisional-only: only sub-N evidence exists. unproven: current evidence has findings not covered by the baseline. clean: every finding is killed or baselined.",
      "enum": [
        "no-claims",
        "unclaimed-changes",
        "invalid-anchors",
        "unprobed",
        "evidence-stale",
        "provisional-only",
        "unproven",
        "clean"
      ]
    },
    "next": {
      "description": "The one action that moves the project forward. `command` is a shell line when the action is a tool command, or an instruction when it is not (write-test, claim for a test file).",
      "type": "object",
      "required": [
        "action",
        "command",
        "why"
      ],
      "properties": {
        "action": {
          "enum": [
            "scaffold",
            "claim",
            "probe",
            "write-test",
            "baseline",
            "review-fault-change",
            "repair-fault",
            "none"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "file": {
          "description": "For claim (and for scaffold when a change is known): the first uncovered changed file the action is about.",
          "$ref": "urn:claimspec:v1:common#/$defs/repoPath"
        },
        "target": {
          "description": "For write-test / review-fault-change: the finding the action is about.",
          "type": "object",
          "required": [
            "claimId",
            "subjectId"
          ],
          "properties": {
            "claimId": {
              "$ref": "urn:claimspec:v1:common#/$defs/identifier"
            },
            "subjectId": {
              "$ref": "urn:claimspec:v1:common#/$defs/identifier"
            },
            "file": {
              "$ref": "urn:claimspec:v1:common#/$defs/repoPath"
            },
            "verdict": {
              "$ref": "urn:claimspec:v1:common#/$defs/verdict"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provisional": {
      "type": "boolean"
    },
    "surface": {
      "description": "The current claim denominator. A source module is a non-test file with a supported source extension that is not covered by the documented default exclusions. Churn is bounded recent git history and remains separate from path-risk signals; neither is collapsed into a score.",
      "type": "object",
      "required": ["sourceModules", "claimedModules", "unclaimedModules", "history", "highChurn", "rankedUnclaimed"],
      "properties": {
        "sourceModules": { "type": "integer", "minimum": 0 },
        "claimedModules": { "type": "integer", "minimum": 0 },
        "unclaimedModules": { "type": "integer", "minimum": 0 },
        "history": {
          "type": "object",
          "required": ["available", "maxCommits", "commitsRead"],
          "properties": {
            "available": { "type": "boolean" },
            "maxCommits": { "type": "integer", "minimum": 1 },
            "commitsRead": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "highChurn": {
          "description": "How many of the up-to-20 most changed source modules carry a claim.",
          "type": "object",
          "required": ["modules", "claimed"],
          "properties": {
            "modules": { "type": "integer", "minimum": 0, "maximum": 20 },
            "claimed": { "type": "integer", "minimum": 0, "maximum": 20 }
          },
          "additionalProperties": false
        },
        "rankedUnclaimed": {
          "description": "Up to ten concrete unclaimed modules, ordered by changes in the bounded history window; path-risk signals break ties and are reported explicitly.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["file", "changes", "riskSignals"],
            "properties": {
              "file": { "$ref": "urn:claimspec:v1:common#/$defs/repoPath" },
              "changes": { "type": "integer", "minimum": 0 },
              "riskSignals": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["security", "money"] }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "run": {
      "description": "Present on probe --json: the validated status document plus the invocation's result. A measured run carries id, evidence, provisional, records and newSinceBaseline, and claims[] (optional in the schema so documents written before it existed stay valid; `probe --json` always writes it). An invocation that selected no claim (--changed matched nothing) or could not tell what changed measured nothing: it carries only exitCode and scope, and names no evidence because none was written. scope is present for a --claim or --changed run.",
      "type": "object",
      "required": ["exitCode"],
      "allOf": [
        {
          "if": { "properties": { "id": true }, "required": ["id"] },
          "then": { "properties": { "evidence": true, "provisional": true, "records": true, "newSinceBaseline": true }, "required": ["evidence", "provisional", "records", "newSinceBaseline"] },
          "else": { "properties": { "scope": true }, "required": ["scope"] }
        }
      ],
      "properties": {
        "originPolicy": { "$ref": "urn:claimspec:v1:common#/$defs/originPolicy" },
        "assertionPolicy": { "$ref": "urn:claimspec:v1:common#/$defs/assertionPolicy" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "provisional": { "type": "boolean" },
        "records": { "type": "integer", "minimum": 0 },
        "newSinceBaseline": { "type": "integer", "minimum": 0 },
        "exitCode": { "enum": [0, 1, 2] },
        "reuse": {
          "description": "Copied from the evidence's run.reuse: records carried forward versus measured by this invocation.",
          "type": "object",
          "required": ["reused", "measured"],
          "properties": { "reused": { "type": "integer", "minimum": 0 }, "measured": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        },
        "claims": {
          "description": "One entry per claim this invocation measured, in the order the claims were probed, keyed by claim id (never by position or line). `result` is derived from `faults` by the rule in GATE-SEMANTICS.md: proven only when at least one fault was measured and every fault is killed; unproven when any fault survived or had no defender; could-not-verify otherwise (the measurement did not happen). It ignores the baseline and the severity floor: it describes this run's measurement, not what gates. `reasons` has one entry per fault that was not killed, keyed by fault id.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claimResult" }
        },
        "budget": {
          "description": "Copied from the evidence's run.budget when probe ran with --partial-on-budget: the command budget, whether it ran out, and how many faults were reached.",
          "type": "object",
          "required": ["limitMs", "exhausted", "reached", "notReached"],
          "properties": {
            "limitMs": { "type": "integer", "minimum": 1 },
            "exhausted": { "type": "boolean" },
            "reached": { "type": "integer", "minimum": 0 },
            "notReached": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "failureKind": {
          "description": "Present only on a run whose command budget ran out (--partial-on-budget). `unproven+incomplete`: the measured part already holds a finding that gates, so the exit code is 1 and `unprovenAtLeast` is its count, a floor (faults not reached are not counted). `policy+incomplete`: the measured part failed a policy (exit 1) without a new gating verdict. `incomplete`: nothing gating so far, exit 2. Never an exit 0.",
          "enum": ["unproven+incomplete", "policy+incomplete", "incomplete"]
        },
        "unprovenAtLeast": {
          "description": "With failureKind `unproven+incomplete`: how many measured faults gate (not baselined, at or above the severity floor). A floor, never a total.",
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "description": "What this invocation selected. `requestedClaims`/`requestedCount` come from --claim; `selectedCount` and `changed` from --changed. Every probed claim was selected.",
          "type": "object",
          "required": ["probedClaims", "probedCount"],
          "properties": {
            "requestedClaims": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" }
            },
            "requestedCount": { "type": "integer", "minimum": 1 },
            "probedClaims": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" }
            },
            "probedCount": { "type": "integer", "minimum": 0 },
            "selectedCount": {
              "description": "Claims left after the change selection and any --claim intersection. 0 means nothing was probed; it is not a pass.",
              "type": "integer",
              "minimum": 0
            },
            "changed": { "$ref": "#/$defs/changedScope" }
          },
          "dependentRequired": { "requestedClaims": ["requestedCount"], "requestedCount": ["requestedClaims"] },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "description": "Present on baseline --json: the validated status document plus what this invocation wrote. `frozen` when a baseline was frozen (the number of unproven findings it holds), `restamped` when an existing baseline's head was moved (the commit it now names). A status document carries at most one invocation result, so it never has both `baseline` and `run`.",
      "oneOf": [
        {
          "type": "object",
          "required": ["path", "frozen"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "frozen": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["path", "restamped"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "restamped": { "$ref": "urn:claimspec:v1:common#/$defs/gitSha" }
          },
          "additionalProperties": false
        }
      ]
    },
    "cost": {
      "description": "Present when probe --json --cost is requested; derived only from the runs in the emitted evidence.",
      "type": "object",
      "required": ["totalMs", "totalRuns", "reusedRecords", "records", "claims", "defenders", "sharedDefenders"],
      "properties": {
        "measurements": {"type": "object", "required": ["elapsedMs", "runnerMs", "overheadMs", "runnerInvocations"], "properties": {"elapsedMs": {"type": "number", "minimum": 0}, "runnerMs": {"type": "number", "minimum": 0}, "overheadMs": {"type": "number", "minimum": 0}, "runnerInvocations": {"type": "integer", "minimum": 0}, "reuseBaselineRuns": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "totalMs": { "type": "number", "minimum": 0 },
        "totalRuns": { "type": "integer", "minimum": 0 },
        "reusedRecords": { "type": "integer", "minimum": 0 },
        "records": { "type": "integer", "minimum": 0 },
        "faults": {
          "description": "Recorded costs and selected defenders per fault; optional for legacy reports.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claimId", "faultId", "ms", "runs", "reused", "defenders"],
            "properties": {
              "claimId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
              "faultId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
              "ms": { "type": "number", "minimum": 0 },
              "runs": { "type": "integer", "minimum": 0 },
              "reused": { "type": "boolean" },
              "selectionSource": { "enum": ["fault", "claim", "discovery"] },
              "defenders": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:claimspec:v1:common#/$defs/repoPath" } }
            },
            "additionalProperties": false
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claimId", "ms", "runs", "faults", "reused", "defenders"],
            "properties": {
              "claimId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
              "ms": { "type": "number", "minimum": 0 },
              "runs": { "type": "integer", "minimum": 0 },
              "faults": { "type": "integer", "minimum": 0 },
              "reused": { "type": "integer", "minimum": 0 },
              "defenders": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "urn:claimspec:v1:common#/$defs/repoPath" }
              }
            },
            "additionalProperties": false
          }
        },
        "defenders": {
          "type": "array",
          "items": { "$ref": "#/$defs/costDefender" }
        },
        "sharedDefenders": {
          "type": "array",
          "items": { "$ref": "#/$defs/costDefender" }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "claims",
        "faults"
      ],
      "properties": {
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "byVerdict": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "killed",
              "survived",
              "nocover",
              "unverifiable",
              "timeout",
              "fault-invalid",
              "flaky-defender"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "killedExceptionOnly": { "description": "Kills made only by an uncaught exception, never by an assertion: the suite reached the code but never checked a value. A named weakness, counted next to `killedCoAuthored`. Legacy records without a recorded kind are not counted.", "type": "integer", "minimum": 0 },
        "killedCoAuthored": { "description": "Kills whose defender was last touched by the same change (or author) as the code it guards — L3 independence. A signal, not a gate.", "type": "integer", "minimum": 0 },
        "flakyDefenderSets": { "description": "Distinct defender sets that failed at least once on unmodified source.", "type": "integer", "minimum": 0 },
        "worstFlakeRate": { "description": "Highest observed failures/runs on unmodified source across all records, 0–1. A number, so \"unstable\" stops being an adjective.", "type": "number", "minimum": 0, "maximum": 1 },
        "baselined": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "stale": {
      "description": "Why the evidence no longer describes the working tree. Empty when it does.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "notes": {
      "description": "Informational lines that never change state or next verification action: e.g. annotation-link advice (not verification or authenticated provenance), or a baseline snapshot with the way to re-stamp it.",
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "changedFaults": {
      "description": "Faults whose find/replace content differs from what the evidence probed. A changed fault that previously survived is the cheapest way to make a finding disappear without a test; it is surfaced, never hidden.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "subjectId",
          "previousVerdict"
        ],
        "properties": {
          "claimId": {
            "$ref": "urn:claimspec:v1:common#/$defs/identifier"
          },
          "subjectId": {
            "$ref": "urn:claimspec:v1:common#/$defs/identifier"
          },
          "previousVerdict": {
            "$ref": "urn:claimspec:v1:common#/$defs/verdict"
          },
          "file": {
            "$ref": "urn:claimspec:v1:common#/$defs/repoPath"
          }
        },
        "additionalProperties": false
      }
    },
    "invalidFaults": {
      "description": "Faults whose exact text anchor does not locate in the current target. These precede every evidence state: a probe cannot learn anything from a fault it cannot apply.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claimId", "subjectId", "file", "reason", "hits", "expected"],
        "properties": {
          "claimId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
          "subjectId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
          "file": { "$ref": "urn:claimspec:v1:common#/$defs/repoPath" },
          "reason": { "enum": ["anchor-missing", "anchor-ambiguous"] },
          "hits": { "type": "integer", "minimum": 0 },
          "expected": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "description": "Unproven findings from the current evidence, ranked, new first, capped.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "claimId",
          "subjectId",
          "verdict",
          "severity",
          "isNew"
        ],
        "properties": {
          "fingerprint": {
            "$ref": "urn:claimspec:v1:common#/$defs/sha256"
          },
          "claimId": {
            "$ref": "urn:claimspec:v1:common#/$defs/identifier"
          },
          "subjectId": {
            "$ref": "urn:claimspec:v1:common#/$defs/identifier"
          },
          "verdict": {
            "$ref": "urn:claimspec:v1:common#/$defs/verdict"
          },
          "reason": {
            "type": "string",
            "maxLength": 256
          },
          "severity": {
            "$ref": "urn:claimspec:v1:common#/$defs/severity"
          },
          "file": {
            "$ref": "urn:claimspec:v1:common#/$defs/repoPath"
          },
          "rank": {
            "type": "number"
          },
          "isNew": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "claimsSource": {
      "description": "Present when the claims file lives outside the project: its hash, never its path (paths.claims is then omitted).",
      "$ref": "urn:claimspec:v1:common#/$defs/claimsSource"
    },
    "thinClaims": {
      "description": "Advisory `claim-thin` signal: claims with fewer than two faults, or whose faults all share one class. Never changes `state`, an exit code or a verdict.",
      "type": "array",
      "items": { "$ref": "#/$defs/thinClaim" }
    },
    "changes": {
      "description": "Claim coverage of the change since `ref`, present only when a reference was given (--changed) or detected from CI. Uncovered files come first in every rendering: the claim is written before more code. Same per-file shapes as the gate document.",
      "type": "object",
      "required": [
        "ref",
        "base",
        "changed",
        "evaluated",
        "excluded",
        "uncovered",
        "reliedOn",
        "expired"
      ],
      "properties": {
        "nested": { "type": "array", "items": { "$ref": "urn:claimspec:v1:common#/$defs/nestedProject" } },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "base": {
          "$ref": "urn:claimspec:v1:common#/$defs/gitSha"
        },
        "includeDirty": {
          "type": "boolean"
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered": {
          "type": "array",
          "items": {
            "$ref": "urn:claimspec:v1:common#/$defs/uncoveredFile"
          }
        },
        "reliedOn": {
          "type": "array",
          "items": {
            "$ref": "urn:claimspec:v1:common#/$defs/ignoreReliance"
          }
        },
        "expired": {
          "type": "array",
          "items": {
            "$ref": "urn:claimspec:v1:common#/$defs/ignoreReliance"
          }
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "string"
        },
        "ignore": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "provisionalEvidence": {
          "type": "string"
        },
        "baseline": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidenceSource": {
      "description": "Whether the evidence read was the project's own (`local`) or supplied with --evidence, e.g. fetched from CI (`provided`).",
      "enum": [
        "local",
        "provided"
      ]
    },
    "evidenceHead": {
      "description": "The commit the evidence describes (its snapshot when the working tree was probed). Present whenever evidence was read.",
      "$ref": "urn:claimspec:v1:common#/$defs/gitSha"
    },
    "head": {
      "description": "HEAD of the working tree the status was computed in, when resolvable. Differs from evidenceHead when the evidence came from elsewhere.",
      "$ref": "urn:claimspec:v1:common#/$defs/gitSha"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claimResult": {
      "type": "object",
      "required": ["id", "result", "faults", "reasons"],
      "properties": {
        "id": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
        "result": { "enum": ["proven", "unproven", "could-not-verify"] },
        "faults": {
          "description": "Verdict counts over the claim's measured faults. total is their sum.",
          "type": "object",
          "required": ["total", "killed", "survived", "nocover", "unverifiable", "faultInvalid", "timeout", "flakyDefender"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "killed": { "type": "integer", "minimum": 0 },
            "survived": { "type": "integer", "minimum": 0 },
            "nocover": { "type": "integer", "minimum": 0 },
            "unverifiable": { "type": "integer", "minimum": 0 },
            "faultInvalid": { "type": "integer", "minimum": 0 },
            "timeout": { "type": "integer", "minimum": 0 },
            "flakyDefender": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["faultId", "verdict"],
            "properties": {
              "faultId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
              "verdict": { "$ref": "urn:claimspec:v1:common#/$defs/verdict" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "changedScope": {
      "description": "How `probe --changed <ref>` selected claims. `determined`: files, matchedClaims and unmatchedFiles are present (all project-relative; a rename lists its old and new path). `undetermined`: git could not say what changed, `reason` names why, nothing was probed and the exit code is 2; it is never an empty change.",
      "type": "object",
      "required": ["ref", "outcome"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "outcome": { "enum": ["determined", "undetermined"] },
        "base": { "$ref": "urn:claimspec:v1:common#/$defs/gitSha" },
        "head": { "$ref": "urn:claimspec:v1:common#/$defs/gitSha" },
        "includeDirty": { "type": "boolean" },
        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "matchedClaims": {
          "description": "Claims a changed file reaches through a fault target, a defender or the import closure, before --claim intersects. A claim whose closure cannot be followed is matched whenever anything changed.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" }
        },
        "unmatchedFiles": {
          "description": "Changed source files no claim's target, defender or closure touches.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": {
          "description": "Always: not covered by any claim; absence from the results is not a pass.",
          "const": "not covered by any claim; absence from the results is not a pass"
        },
        "reason": {
          "type": "object",
          "required": ["kind", "message"],
          "properties": {
            "kind": { "enum": ["ref-unresolved", "no-merge-base", "git-timeout", "git-failed"] },
            "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "additionalProperties": false
        }
      },
      "if": { "properties": { "outcome": { "const": "determined" } } },
      "then": { "properties": { "base": true, "head": true, "includeDirty": true, "files": true, "matchedClaims": true, "unmatchedFiles": true, "note": true, "reason": false }, "required": ["base", "head", "includeDirty", "files", "matchedClaims", "unmatchedFiles", "note"] },
      "else": { "properties": { "reason": true, "files": false, "matchedClaims": false, "unmatchedFiles": false }, "required": ["reason"] },
      "additionalProperties": false
    },
    "thinClaim": {
      "type": "object",
      "required": ["claimId", "signal", "reason", "faults", "faultClasses"],
      "properties": {
        "claimId": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" },
        "signal": { "const": "claim-thin" },
        "reason": { "enum": ["fewer-than-two-faults", "single-fault-class"] },
        "faults": { "type": "integer", "minimum": 0 },
        "faultClasses": { "type": "array", "uniqueItems": true, "items": { "$ref": "urn:claimspec:v1:common#/$defs/faultClass" } }
      },
      "additionalProperties": false
    },
    "costDefender": {
      "type": "object",
      "required": ["file", "ms", "runs", "claims"],
      "properties": {
        "file": { "$ref": "urn:claimspec:v1:common#/$defs/repoPath" },
        "ms": { "type": "number", "minimum": 0 },
        "runs": { "type": "integer", "minimum": 0 },
        "faults": {
          "description": "Distinct claimId/faultId identities selecting this file, not confirmation runs.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "urn:claimspec:v1:common#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    }
  }
}
