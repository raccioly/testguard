      "statement": "After a fault is applied in place, restore() puts the original file content back.",
      "source": { "kind": "spec", "ref": "README.md#how-it-works; SECURITY.md#security-model" },
      "severity": "critical",
      "producedBy": { "producer": "human", "by": "maintainer", "at": "2026-09-17T00:00:00Z" },
