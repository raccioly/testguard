  "claims": [
    {
      "id": "TG-KILL-NEEDS-N",
      "statement": "A fault is killed only when every one of the N probe runs fails with an assertion; a mixed result is never a kill.",
      "source": { "kind": "spec", "ref": "spec/GATE-SEMANTICS.md#verdicts rule 2 and 4" },
      "severity": "critical",
      "producedBy": { "producer": "human", "by": "maintainer", "at": "2026-09-17T00:00:00Z" },
      "defendedBy": ["test/classify.test.mjs"],
      "faults": [
        {
          "id": "F1",
          "description": "One killing run is enough to report killed (optimistic bias).",
          "faultClass": "condition-forced",
          "file": "src/probe/classify.mjs",
          "find": "if (probeRuns.length === confirmRuns && killedRuns.length === confirmRuns) return { verdict: 'killed' };",
          "replace": "if (killedRuns.length >= 1) return { verdict: 'killed' };",
          "producedBy": { "producer": "human", "by": "maintainer" }
        }
      ]
    },
    {
      "id": "TG-TIMEOUT-NEVER-KILLS",
      "statement": "A timeout is never counted as a detection.",
      "source": { "kind": "spec", "ref": "spec/GATE-SEMANTICS.md#verdicts rule 3" },
      "severity": "critical",
      "producedBy": { "producer": "human", "by": "maintainer", "at": "2026-09-17T00:00:00Z" },
      "defendedBy": ["test/classify.test.mjs"],
      "faults": [
        {
          "id": "F1",
          "description": "The timeout check is removed; a timed-out run falls through to the kill/survive logic.",
          "faultClass": "guard-removed",
          "file": "src/probe/classify.mjs",
          "find": "if (probeRuns.some((r) => r.outcome === 'timeout' || r.timeouts > 0)) return { verdict: 'timeout', reason: 'test-timed-out' };",
          "replace": "/* fault: timeout check removed */",
          "producedBy": { "producer": "human", "by": "maintainer" }
        }
      ]
    },
    {
      "id": "TG-WRITER-REFUSES",
