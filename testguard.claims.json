          "replace": "/* fault: validation ignored */",
          "producedBy": { "producer": "human", "by": "maintainer" }
        }
      ]
    },
    {
      "id": "TG-FINGERPRINT-VERDICT",
      "statement": "The fingerprint includes the verdict, so a change of verdict on the same claim and subject surfaces as a new finding.",
